   "t0": 35.781,
   "t1": 37.374,
   "text": "Maya typed for a long time."
  },
  "msg": {
   "speaker": "MAYA",
   "t0": 38.474,
   "t1": 44.961,
   "text": "This was my dad's number. He died last winter. I call to hear his voicemail. I'm sorry. I'll stop."
  },
  "dots": {
   "speaker": "NAR",
   "t0": 45.961,
   "t1": 48.715,
   "text": "The dots appeared. Disappeared. Appeared again."
  },
