   "text": "The anniversary came on a Thursday."
  },
  "goodbye": {
   "speaker": "NAR",
   "t0": 96.591,
   "t1": 101.865,
   "text": "At eleven, Maya decided it was time to say goodbye. To the number. To all of it."
  },
  "rang": {
   "speaker": "NAR",
   "t0": 102.365,
   "t1": 105.501,
   "text": "She called. It rang. And rang. Theo didn't pick up."
  },
  "voice": {
   "speaker": "NAR",
   "t0": 106.901,
   "t1": 108.72,
   "text": "Then, a voice she didn't expect."
  },
