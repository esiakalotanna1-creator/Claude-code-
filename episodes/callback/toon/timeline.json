  },
  "next": {
   "speaker": "NAR",
   "t0": 52.615,
   "t1": 55.395,
   "text": "The next night, at eleven, her phone buzzed first."
  },
  "ok": {
   "speaker": "SCREEN",
   "t0": 55.595,
   "t1": 57.795,
   "text": "it's 11. you ok?"
  },
  "wasnt": {
   "speaker": "NAR",
   "t0": 58.095,
   "t1": 60.649,
   "text": "She wasn't. So she called. And he picked up."
  },
  "loud": {
   "speaker": "NAR",
   "t0": 61.449,
   "t1": 67.429,
   "text": "His mom worked nights at the hospital. The house was loud when it was empty. So was her apartment."
  },
  "homework": {
   "speaker": "NAR",
   "t0": 68.229,
   "t1": 74.855,
   "text": "So every night at eleven: chemistry homework. Terrible jokes. Long silences that didn't feel lonely."
  },
  "laughed": {
   "speaker": "NAR",
   "t0": 75.455,
   "t1": 79.061,
   "text": "One night, she laughed. Out loud. For the first time in a year."
  },
  "told": {
   "speaker": "NAR",
   "t0": 80.461,
   "t1": 83.894,
   "text": "She told him how every call with her dad ended the same way."
  },
  "callback": {
   "speaker": "MAYA",
